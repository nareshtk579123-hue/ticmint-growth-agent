# LLM Configuration (Gemini API)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google Sheets Integration
# Path to Google Service Account JSON file (e.g. ./credentials/service_account.json)
GOOGLE_SERVICE_ACCOUNT_JSON=
# OR inline raw JSON string of the service account key (useful for GitHub Secrets)
GOOGLE_SERVICE_ACCOUNT_RAW_JSON=
# The Google Sheet ID from your URL (https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=

# Agent Execution Settings
RUN_MODE=live
DRY_RUN=false
MAX_SIGNALS_PER_RUN=25
MIN_LEAD_SCORE_QUALIFIED=50
MIN_LEAD_SCORE_HIGH_PRIORITY=75
LOG_LEVEL=INFO
